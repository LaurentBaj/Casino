@page "/game"
@using System.Net.WebSockets
@using System.Text
@using System.Text.Json
@using System.Text.Json.Serialization
@using Casino.BlazorClient.Models
@inject NavigationManager Navigation

<PageTitle>Casino</PageTitle>

<h1>Casino Card Game</h1>

@if (_connectionState == WebSocketState.None || _connectionState == WebSocketState.Closed)
{
    <button class="btn btn-primary" @onclick="ConnectToGame">Join Game</button>
}
else if (_gameState == null && _waitingFor > 0)
{
    <div class="alert alert-info">
        Waiting for @(_waitingFor) more player(s) to join...
    </div>
}
else if (_gameState != null)
{
    <div class="game-board p-4 border rounded" style="background: #2e7d32; color: white;">

        <!-- Opponents -->
        <div class="opponents mb-5 text-center">
            <h3>Opponent</h3>
            @foreach (var opp in _gameState.Opponents)
            {
                <div class="d-flex justify-content-center gap-2 mb-2">
                    @for(int i = 0; i < opp.CardCount; i++)
                    {
                        <PlayingCard Hidden="true" />
                    }
                </div>
                <div>
                    <span class="badge bg-secondary">Captured: @opp.CapturedCount</span>
                    <span class="badge bg-secondary">Sweeps: @opp.SweepsCount</span>
                </div>
            }
        </div>

        <hr class="text-white"/>

        <!-- Board -->
        <div class="board mb-5 text-center">
            <h3>Board</h3>
            <div class="d-flex justify-content-center gap-3 flex-wrap">
                @if (_gameState.BoardSlots.Count == 0)
                {
                    <p class="fst-italic text-light">Board is empty.</p>
                }
                @foreach (var slot in _gameState.BoardSlots)
                {
                    <div class="slot border border-warning rounded p-2 text-dark bg-white" style="min-width: 80px;">
                        <div class="d-flex flex-column align-items-center gap-1">
                        @foreach(var card in slot.Cards)
                        {
                            <PlayingCard CardString="@card" />
                        }
                        </div>
                        <div class="badge bg-warning text-dark mt-2">@slot.AggregatePoints pts</div>
                    </div>
                }
            </div>
        </div>

        <hr class="text-white"/>

        <!-- My Hand -->
        <div class="my-hand text-center">
            <h3>My Hand</h3>
            <div class="d-flex justify-content-center gap-3 mb-3">
                @foreach (var card in _gameState.MyHand)
                {
                    <div style="cursor: pointer;" @onclick="() => PlayCard(card)">
                        <PlayingCard CardString="@card" />
                    </div>
                }
            </div>
            <div>
                <span class="badge bg-primary">My Captured: @(_gameState.MyCaptured.Count)</span>
                <span class="badge bg-primary">My Sweeps: @(_gameState.MySweeps.Count)</span>
            </div>

            @if (_gameState.IsMyTurn)
            {
                <h4 class="mt-3 text-warning">It is your turn! (Click a card to play)</h4>
            }
        </div>
    </div>
}

@code {
    private ClientWebSocket _webSocket = new();
    private WebSocketState _connectionState = WebSocketState.None;

    private int _waitingFor = 0;
    private ClientGameStateDto? _gameState = null;

    private async Task ConnectToGame()
    {
        var wsUri = new Uri(Navigation.BaseUri.Replace("http", "ws") + "ws");

        try
        {
            await _webSocket.ConnectAsync(wsUri, CancellationToken.None);
            _connectionState = _webSocket.State;
            StateHasChanged();

            var joinMsg = JsonSerializer.Serialize(new { Case = "Join", Fields = new[] { "Player" } });
            var bytes = Encoding.UTF8.GetBytes(joinMsg);
            await _webSocket.SendAsync(new ArraySegment<byte>(bytes), WebSocketMessageType.Text, true, CancellationToken.None);

            _ = ReceiveLoop();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"WebSocket error: {ex.Message}");
        }
    }

    private async Task PlayCard(string card)
    {
        if (_gameState?.IsMyTurn == true && _connectionState == WebSocketState.Open)
        {
            var playMsg = JsonSerializer.Serialize(new { Case = "PlayCard", Fields = new[] { card } });
            var bytes = Encoding.UTF8.GetBytes(playMsg);
            await _webSocket.SendAsync(new ArraySegment<byte>(bytes), WebSocketMessageType.Text, true, CancellationToken.None);
        }
    }

    private async Task ReceiveLoop()
    {
        var buffer = new byte[4096];

        while (_webSocket.State == WebSocketState.Open)
        {
            var result = await _webSocket.ReceiveAsync(new ArraySegment<byte>(buffer), CancellationToken.None);

            if (result.MessageType == WebSocketMessageType.Close)
            {
                await _webSocket.CloseAsync(WebSocketCloseStatus.NormalClosure, string.Empty, CancellationToken.None);
            }
            else
            {
                var msg = Encoding.UTF8.GetString(buffer, 0, result.Count);
                Console.WriteLine("RECV: " + msg);
                ParseServerMessage(msg);
                StateHasChanged();
            }
        }

        _connectionState = _webSocket.State;
        StateHasChanged();
    }

    private void ParseServerMessage(string json)
    {
        try
        {
            var doc = JsonDocument.Parse(json);
            var root = doc.RootElement;

            if (root.TryGetProperty("Case", out var caseProp))
            {
                var caseName = caseProp.GetString();
                if (caseName == "WaitingForPlayers")
                {
                    _waitingFor = root.GetProperty("Fields")[0].GetInt32();
                }
                else if (caseName == "GameState")
                {
                    _gameState = JsonSerializer.Deserialize<ClientGameStateDto>(root.GetProperty("Fields")[0].GetRawText(), new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine("Error parsing: " + ex.Message);
        }
    }
}
