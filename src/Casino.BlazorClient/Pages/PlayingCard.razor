@code {
    [Parameter]
    public string CardString { get; set; } = string.Empty;

    [Parameter]
    public bool Hidden { get; set; } = false;

    private string GetSuitSymbol()
    {
        if (CardString.Contains("Spades")) return "♠";
        if (CardString.Contains("Hearts")) return "♥";
        if (CardString.Contains("Diamonds")) return "♦";
        if (CardString.Contains("Clubs")) return "♣";
        return "";
    }

    private string GetRankSymbol()
    {
        var parts = CardString.Split(" of ");
        if (parts.Length > 0)
        {
            var rank = parts[0];
            if (rank == "10") return "10";
            if (rank.Length > 0) return rank.Substring(0, 1);
        }
        return "?";
    }

    private string GetColor()
    {
        return (CardString.Contains("Hearts") || CardString.Contains("Diamonds")) ? "red" : "black";
    }
}

@if (Hidden)
{
    <svg width="80" height="120" xmlns="http://www.w3.org/2000/svg">
      <rect width="80" height="120" rx="5" ry="5" fill="#1a237e" stroke="white" stroke-width="2"/>
      <pattern id="pattern" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <rect width="10" height="10" fill="#3949ab"/>
        <path d="M0,0 L0,10 L10,10 L10,0 Z" fill="none" stroke="#1a237e" stroke-width="2"/>
      </pattern>
      <rect width="76" height="116" x="2" y="2" rx="4" ry="4" fill="url(#pattern)"/>
    </svg>
}
else
{
    <svg width="80" height="120" xmlns="http://www.w3.org/2000/svg" style="background: white; border-radius: 5px; box-shadow: 0 4px 8px rgba(0,0,0,0.2);">
        <rect width="80" height="120" rx="5" ry="5" fill="none" stroke="#ccc" stroke-width="1"/>
        <text x="5" y="15" font-family="sans-serif" font-size="14" font-weight="bold" fill="@GetColor()">@GetRankSymbol()</text>
        <text x="5" y="30" font-family="sans-serif" font-size="14" fill="@GetColor()">@GetSuitSymbol()</text>

        <text x="40" y="70" font-family="sans-serif" font-size="30" text-anchor="middle" fill="@GetColor()">@GetSuitSymbol()</text>

        <text x="75" y="115" font-family="sans-serif" font-size="14" font-weight="bold" fill="@GetColor()" transform="rotate(180 75 115)">@GetRankSymbol()</text>
        <text x="75" y="100" font-family="sans-serif" font-size="14" fill="@GetColor()" transform="rotate(180 75 100)">@GetSuitSymbol()</text>
    </svg>
}
